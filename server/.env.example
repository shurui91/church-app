# Server Configuration
PORT=3000
NODE_ENV=development

# JWT Secret (generate a random string for production)
JWT_SECRET=your-secret-key-here-change-in-production
JWT_EXPIRES_IN=7d

# Twilio — Account（Verify 与 Messages 共用）
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token

# Twilio Verify（推荐生产登录）
# 在 Twilio Console → Verify → Services 创建服务，将 Service SID（常以 VA 开头）填在这里。
# 若设置了该项，发码/校验走 Verify API，白名单仍只由本应用 users 表决定。
TWILIO_VERIFY_SERVICE_SID=

# Twilio Messages（仅当「未」配置 TWILIO_VERIFY_SERVICE_SID 时的回退方案：自建验证码表 + 短信)
# 若已配置 Verify，可不填发件号码。
TWILIO_PHONE_NUMBER=

# 生产 (NODE_ENV=production) 或设为 true 时：必须有可用的短信登录配置（Verify 或 Messages+号码），否则发码失败。
# SMS_REQUIRE_PROVIDER=false

# 本地开发、且走 Messages 回退未配置 Twilio 时，控制台会打印验证码。
# 若要在本地也强制真实短信，设置: SMS_REQUIRE_PROVIDER=true

# 固定验证码 123456（不发真实短信）。未设置时：非 production 默认开启；production 默认关闭（走真实 Twilio）。
# 设为 false 可在本地也强制走真实 Twilio（已配置时）。
# SMS_USE_FIXED_CODE=
# production 且必须仍用 123456 时（如预发环境）须同时：
# SMS_USE_FIXED_CODE=true
# SMS_FIXED_CODE_ALLOWED_IN_PRODUCTION=true
#
# 旧变量：仅非 production 且已配置 Verify 时与 SMS_USE_FIXED_CODE 类似；可改用上方统一开关。
# ALLOW_DEV_VERIFY_BYPASS=true

# Database Configuration
DB_PATH=./database.sqlite
